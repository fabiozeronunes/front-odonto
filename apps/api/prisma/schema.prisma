generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id @default(cuid())
  name                  String
  email                 String                   @unique
  passwordHash          String
  role                  Role                     @default(USER)
  isActive              Boolean                  @default(true)
  planId                String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  phone                 String?
  affiliateCode         String?                  @unique
  commissionRate        Decimal                  @default(20)
  isAffiliate           Boolean                  @default(false)
  referredById          String?
  registrationNumber    String?                  @unique
  productCommissionRate Decimal                  @default(20)
  geminiApiKey          String?
  emailVerified         Boolean                  @default(false)
  tokenVersion          Int                      @default(0)
  curso                 String?
  courseDisciplines     CourseDiscipline[]
  affiliateCommissions  AffiliateCommission[]    @relation("AffiliateCommissions")
  referredCommissions   AffiliateCommission[]    @relation("ReferredCommissions")
  caseStudies           CaseStudy[]
  emailVerifications    EmailVerificationToken[]
  favorites             Favorite[]
  orders                Order[]
  passwordResetTokens   PasswordResetToken[]
  specialties           Specialty[]
  studyResources        StudyResource[]          @relation("StudyAuthor")
  studyVotes            StudyVote[]
  subscriptions         Subscription[]
  tags                  Tag[]
  plan                  MembershipPlan           @relation(fields: [planId], references: [id])
  referredBy            User?                    @relation("Referrals", fields: [referredById], references: [id])
  referrals             User[]                   @relation("Referrals")
  videos                Video[]
  watchHistory          WatchHistory[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  twoFactorSecret       TwoFactorSecret?
  gradeSchedules        GradeSchedule[]

  @@index([email])
  @@index([referredById])
}

model MembershipPlan {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  description   String?
  price         Decimal        @default(0)
  billing       BillingPeriod  @default(MONTHLY)
  benefits      Json?
  status        PlanStatus     @default(ACTIVE)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  users         User[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(PENDING)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  plan      MembershipPlan     @relation(fields: [planId], references: [id])
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([userId])
  @@index([status])
}

model Specialty {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  description String?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  createdById String?
  caseStudies CaseStudy[]
  createdBy   User?       @relation(fields: [createdById], references: [id])
  videos      Video[]

  @@index([createdById])
}

model Tag {
  id              String              @id @default(cuid())
  name            String              @unique
  slug            String              @unique
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdById     String?
  caseStudyAudios CaseStudyAudioTag[]
  caseStudies     CaseStudyTag[]
  media           MediaTag[]
  products        ProductTag[]
  createdBy       User?               @relation(fields: [createdById], references: [id])
  videoAudios     VideoAudioTag[]
  videos          VideoTag[]

  @@index([createdById])
}

model Video {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  description     String?
  thumbnailUrl    String?
  videoType       VideoType        @default(EMBED)
  videoUrl        String
  durationSeconds Int?
  difficulty      Difficulty       @default(BASICO)
  isFree          Boolean          @default(true)
  author          String?
  institution     String?
  status          ContentStatus    @default(DRAFT)
  publishedAt     DateTime?
  viewCount       Int              @default(0)
  specialtyId     String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now())
  observations    String?
  source          VideoSource      @default(FRONTODONTUS)
  audioTitle      String?
  audioUrl        String?
  recordedUrl     String?
  recordedTitle   String?
  recordedDate    String?
  recordedTime    String?
  recordedOrientation String?
  disciplina      String?
  curso           String?
  recordedDisciplina String?
  recordedCurso   String?
  favorites       Favorite[]
  images          Media[]
  studyResources  StudyResource[]
  createdBy       User?            @relation(fields: [createdById], references: [id])
  specialty       Specialty?       @relation(fields: [specialtyId], references: [id])
  audios          VideoAudio[]
  audioTags       VideoAudioTag[]
  caseStudies     VideoCaseStudy[]
  tags            VideoTag[]
  watchHistory    WatchHistory[]

  @@index([specialtyId, status])
  @@index([status, isFree])
  @@index([createdById])
  @@index([title])
  @@index([publishedAt])
}

model VideoTag {
  videoId String
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

model VideoAudioTag {
  videoId String
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}

model VideoAudio {
  id        String   @id @default(cuid())
  url       String
  title     String?
  disciplina String?
  curso     String?
  videoId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

model CaseStudy {
  id             String              @id @default(cuid())
  title          String
  slug           String              @unique
  description    String?
  diagnosis      String?
  difficulty     Difficulty          @default(BASICO)
  isFree         Boolean             @default(false)
  status         ContentStatus       @default(DRAFT)
  author         String?
  institution    String?
  specialtyId    String?
  createdById    String?
  publishedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  observations   String?
  audioUrl       String?
  audioTitle     String?
  createdBy      User?               @relation(fields: [createdById], references: [id])
  specialty      Specialty?          @relation(fields: [specialtyId], references: [id])
  audioTags      CaseStudyAudioTag[]
  relatedCases   CaseStudyRelated[]  @relation("related")
  relatedFrom    CaseStudyRelated[]  @relation("relatedFrom")
  tags           CaseStudyTag[]
  images         Media[]
  studyResources StudyResource[]
  videoCases     VideoCaseStudy[]

  @@index([specialtyId, status])
  @@index([createdById])
  @@index([title])
}

model CaseStudyAudioTag {
  caseStudyId String
  tagId       String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([caseStudyId, tagId])
  @@index([tagId])
}

model CaseStudyTag {
  caseStudyId String
  tagId       String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([caseStudyId, tagId])
  @@index([tagId])
}

model VideoCaseStudy {
  videoId     String
  caseStudyId String
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, caseStudyId])
  @@index([caseStudyId])
}

model CaseStudyRelated {
  id          String    @id @default(cuid())
  caseStudyId String
  relatedId   String
  createdAt   DateTime  @default(now())
  caseStudy   CaseStudy @relation("related", fields: [caseStudyId], references: [id], onDelete: Cascade)
  related     CaseStudy @relation("relatedFrom", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([caseStudyId, relatedId])
  @@index([caseStudyId])
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, watchedAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
}

model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String?
  price        Decimal          @default(0)
  promoPrice   Decimal?
  sku          String?
  stock        Int              @default(0)
  status       ContentStatus    @default(DRAFT)
  isFeatured   Boolean          @default(false)
  brand        String?
  categoryId   String?
  accessLevel  AccessLevel      @default(PUBLIC)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  saleEndsAt   DateTime?
  saleStartsAt DateTime?
  images       Media[]
  orderItems   OrderItem[]
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  tags         ProductTag[]

  @@index([status])
  @@index([categoryId])
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model MediaTag {
  mediaId String
  tagId   String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId])
}

model Media {
  id          String     @id @default(cuid())
  url         String
  alt         String?
  productId   String?
  createdAt   DateTime   @default(now())
  caseStudyId String?
  videoId     String?
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  video       Video?     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tags        MediaTag[]

  @@index([productId])
  @@index([videoId])
  @@index([caseStudyId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PENDING)
  subtotal  Decimal     @default(0)
  discount  Decimal     @default(0)
  total     Decimal     @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]

  @@index([userId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  unitPrice Decimal @default(0)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model AffiliateCommission {
  id             String           @id @default(cuid())
  affiliateId    String
  referredUserId String
  amount         Decimal          @default(0)
  percent        Decimal          @default(20)
  status         CommissionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  paidAt         DateTime?
  planName       String?
  productName    String?
  source         String           @default("PLAN")
  affiliate      User             @relation("AffiliateCommissions", fields: [affiliateId], references: [id], onDelete: Cascade)
  referred       User             @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([referredUserId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudyResource {
  id          String              @id @default(cuid())
  type        StudyResourceType
  status      StudyResourceStatus @default(RASCUNHO)
  title       String
  content     Json
  audioUrl    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  videoId     String?
  authorId    String
  caseStudyId String?
  author      User                @relation("StudyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  caseStudy   CaseStudy?          @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  video       Video?              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  votes       StudyVote[]

  @@index([videoId])
  @@index([caseStudyId])
  @@index([authorId])
  @@index([status])
}

model StudyVote {
  id         String        @id @default(cuid())
  value      Int           @default(1)
  createdAt  DateTime      @default(now())
  resourceId String
  userId     String
  resource   StudyResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

enum Role {
  ADMIN
  USER
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELED
  EXPIRED
}

enum VideoType {
  EMBED
  EXTERNAL
  UPLOAD
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BASICO
  INTERMEDIARIO
  AVANCADO
}

enum VideoSource {
  FRONTODONTUS
  STUDENT
}

enum AccessLevel {
  PUBLIC
  MEMBER
  PREMIUM
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELED
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELED
}

enum StudyResourceType {
  QUIZ
  FLASHCARDS
  QUESTIONARIO
  MIND_MAP
  INFOGRAPHIC
  RESUMO
  AUDIO_RESUMO
  TRANSCRICAO
}

enum StudyResourceStatus {
  RASCUNHO
  EM_REVISAO
  PUBLICADO
  REJEITADO
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  resourceId String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model TwoFactorSecret {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret      String
  enabled     Boolean  @default(false)
  backupCodes String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ip])
  @@index([createdAt])
}

model GradeSchedule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  period       Int
  day          String
  turma        String   @default("")
  bloco        String   @default("")
  sala         String   @default("")
  curso        String   @default("")
  turno        String   @default("Noturno")
  professor    String   @default("")
  period1Start String   @default("")
  period1End   String   @default("")
  period2Start String   @default("")
  period2End   String   @default("")
  color        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CourseDiscipline {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@index([userId])
}
