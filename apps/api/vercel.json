{
  "version": 2,
  "buildCommand": "npx prisma generate",
  "github": {
    "enabled": true,
    "autoAlias": false,
    "silent": false
  },
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}