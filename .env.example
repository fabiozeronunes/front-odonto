# Copie para .env e preencha os valores
# Nunca commite este arquivo!

# Database (Supabase ou local)
DATABASE_URL=postgresql://odonto:odonto_dev_password@localhost:5432/odonto_study

# JWT
JWT_SECRET=gere_um_secret_de_32_chars_minimo_aqui
JWT_REFRESH_SECRET=gere_outro_secret_de_32_chars_minimo_aqui
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=gere_um_secret_de_32_chars_minimo_aqui

# URLs
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@seudominio.com

# YouTube (OAuth)
YOUTUBE_CLIENT_ID=...
YOUTUBE_CLIENT_SECRET=...
YOUTUBE_REFRESH_TOKEN=...
YOUTUBE_CATEGORY_ID=27

# Vercel (para GitHub Actions)
VERCEL_TOKEN=...
VERCEL_ORG_ID=...
VERCEL_PROJECT_ID_API=...
VERCEL_PROJECT_ID_WEB=...