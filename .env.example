# ===== API =====
DATABASE_URL=postgresql://odonto:odonto_dev_password@localhost:5432/odonto_study
PORT=4000
NODE_ENV=development
# Segredo JWT (use valor longo e aleatório em produção)
JWT_SECRET=dev_jwt_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_me
JWT_REFRESH_EXPIRES_IN=7d
# URL pública da API (usada pelo frontend)
API_URL=http://localhost:4000
# URL pública do frontend (CORS)
WEB_URL=http://localhost:5173
# Taxa de requisições por minuto por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ===== Web =====
VITE_API_URL=http://localhost:4000

